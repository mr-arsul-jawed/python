    "import seaborn as sns\n",
    "import matplotlib.pyplot as plt\n",
    "import pandas as pd\n",
    "\n",
    "\n",
    "data = sns.load_dataset(\"tips\")\n",
    "# print(data)\n",
    "\n",
    "a = sns.FacetGrid(data, col = \"time\",height= 2, hue = \"sex\")\n",
    "a.map(sns.barplot, \"day\", \"tip\")\n",
    "plt.show()"
